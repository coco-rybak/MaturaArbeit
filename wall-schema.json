{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Schema der Kletterrouten an der Wand",
    "type": "object",
    "properties": {
        "width": {
            "type": "integer"
        },
        "height": {
            "type": "integer"
        },
        "holds": {
            "type": "array",
            "description": "Eine Liste aller Griffe an der Wand.",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "x": {
                        "type": "integer"
                    },
                    "y": {
                        "type": "integer"
                    },
                    "type": {
                        "enum": [
                            "jug",
                            "crimp",
                            "sloper",
                            "pinch",
                            "pocket"
                        ],
                        "default": "jug"
                    }
                },
                "required": [
                    "id",
                    "x",
                    "y"
                ]
            }
        },
        "route": {
            "type": "array",
            "description": "Die Reihenfolge der Griff-IDs, aus denen sich die Route zusammensetzt.",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "width",
        "height",
        "holds",
        "route"
    ]
}